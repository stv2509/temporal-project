# Django (backend/config/settings.py)
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost 127.0.0.1 portal.test.local
CSRF_TRUSTED_ORIGINS=http://localhost:8000 https://portal.test.local

# Database mode: sqlite | postgres
DB_ENGINE=sqlite
# PostgreSQL (used when DB_ENGINE=postgres)
# POSTGRES_HOST=awxdbcl.test.local
# POSTGRES_PORT=5433
# POSTGRES_DB=autoops
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=
# POSTGRES_SCHEMA=portal

# Temporal (backend + worker)
TEMPORAL_HOST=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE_K8S_ACCESS=awx-task-queue
TEMPORAL_WORKFLOW_K8S_ACCESS=K8sAccessCheckWorkflow
# TEMPORAL_WORKFLOW_VM_CREATE=VmCreateWorkflow
# TEMPORAL_TASK_QUEUE_VM_CREATE=vm-create-task-queue

# AWX environment routing:
# test -> test AWX, prod -> prod AWX, dev обычно маппится на test
AWX_ENV=test

# TLS verification for all HTTPS requests in worker (httpx).
# Allowed values:
# - path to PEM CA bundle file, e.g. /etc/ssl/certs/corporate-ca-bundle.pem
# - true
# - false
# If unset/empty -> use system default trust store.
CA_BUNDLE_PATH=true

# Backend API — для worker activities (Basic Auth к DRF)
BACKEND_API_URL=http://localhost:8000
BACKEND_API_USER=admin
BACKEND_API_PASSWORD=

# AWX test profile
# AWX_URL_TEST=https://awx-test.example.com
# AWX_USERNAME_TEST=admin
# AWX_PASSWORD_TEST=
# ENCRYPTION_KEY_TEST=
# AWX_PASSWORD_ENCRYPTED_TEST=

# AWX prod profile
# AWX_URL_PROD=https://awx-prod.example.com
# AWX_USERNAME_PROD=admin
# AWX_PASSWORD_PROD=
# ENCRYPTION_KEY_PROD=
# AWX_PASSWORD_ENCRYPTED_PROD=

# Legacy AWX (fallback для совместимости)
# AWX_URL=https://awx.example.com
# AWX_USERNAME=admin
# Пароль: либо открытый AWX_PASSWORD, либо зашифрованный AWX_PASSWORD_ENCRYPTED + ENCRYPTION_KEY
# AWX_PASSWORD=
# Ключ Fernet для расшифровки (python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())")
# ENCRYPTION_KEY=
# Зашифрованный пароль (python -c "from cryptography.fernet import Fernet; f=Fernet('KEY'); print(f.encrypt(b'password').decode())")
# AWX_PASSWORD_ENCRYPTED=
