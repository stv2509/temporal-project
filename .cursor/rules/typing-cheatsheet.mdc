## 🆕 Новые возможности Python 3.13

### 1. TypeVar с default значениями (PEP 696)

```python
from typing import TypeVar

# ✅ Python 3.13: TypeVar с default
T = TypeVar('T', default=str)

def get_value(key: str, default: T = "not_found") -> T:
    """Получить значение с fallback типом"""
    return default

# Примеры использования
result1 = get_value("key")              # type: str
result2 = get_value("key", 42)          # type: int
result3 = get_value("key", [1, 2, 3])   # type: list[int]
```

### 2. TypeIs для точного сужения типов (PEP 742)

```python
from typing import TypeIs

# ✅ Python 3.13: более точное сужение чем TypeGuard
def is_str_list(val: list[object]) -> TypeIs[list[str]]:
    """Проверка что все элементы списка - строки"""
    return all(isinstance(x, str) for x in val)

def is_int_list(val: list[object]) -> TypeIs[list[int]]:
    """Проверка что все элементы списка - числа"""
    return all(isinstance(x, int) for x in val)

# Использование в коде
items: list[object] = ["a", "b", "c"]

if is_str_list(items):
    # items теперь точно list[str], не list[object]
    result = ", ".join(items)  # ✅ Type checker OK!
    upper = [s.upper() for s in items]  # ✅ OK!

numbers: list[object] = [1, 2, 3]
if is_int_list(numbers):
    # numbers теперь точно list[int]
    total = sum(numbers)  # ✅ OK!
```

### 3. ReadOnly для TypedDict (PEP 705)

```python
from typing import TypedDict, ReadOnly

# ✅ Python 3.13: поля только для чтения
class AppConfig(TypedDict):
    app_name: ReadOnly[str]        # Нельзя изменять
    version: ReadOnly[str]         # Нельзя изменять
    environment: ReadOnly[str]     # Нельзя изменять
    debug: bool                    # Можно изменять
    max_connections: int           # Можно изменять

# Создание конфигурации
config: AppConfig = {
    "app_name": "My Application",
    "version": "1.0.0",
    "environment": "production",
    "debug": False,
    "max_connections": 100,
}

# ✅ OK - изменение обычных полей
config["debug"] = True
config["max_connections"] = 200

# ❌ Type checker error! - попытка изменить ReadOnly поля
config["app_name"] = "Other"  # Error: "app_name" is read-only
config["version"] = "2.0.0"   # Error: "version" is read-only
```

### 4. Комбинированный пример

```python
from typing import TypeVar, TypeIs, TypedDict, ReadOnly

# Конфигурация с ReadOnly полями
class DatabaseConfig(TypedDict):
    host: ReadOnly[str]
    port: ReadOnly[int]
    database: ReadOnly[str]
    username: str
    password: str
    pool_size: int

config: DatabaseConfig = {
    "host": "localhost",
    "port": 5432,
    "database": "myapp",
    "username": "admin",
    "password": "secret",
    "pool_size": 20,
}

# ✅ Можно менять credentials и настройки
config["username"] = "new_admin"
config["pool_size"] = 50

# ❌ Нельзя менять connection параметры
# config["host"] = "other_host"  # Type error!

# Generic с default для repository
T = TypeVar('T', default=dict[str, str])

class CacheRepository:
    def get(self, key: str, default: T = {}) -> T:
        """Получить данные с fallback"""
        return self._cache.get(key, default)

# TypeIs для валидации
def is_valid_config(data: dict[str, object]) -> TypeIs[DatabaseConfig]:
    """Проверка что dict соответствует DatabaseConfig"""
    required = {"host", "port", "database", "username", "password", "pool_size"}
    return all(key in data for key in required)

# Использование
raw_config: dict[str, object] = load_config()
if is_valid_config(raw_config):
    # raw_config теперь DatabaseConfig, можем безопасно использовать
    connect_to_db(raw_config)
```

